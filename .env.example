# MongoDB Database connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/chatify

# JWT Authentication secret
JWT_SECRET=your_super_secret_jwt_key_here

# Pusher Channels (Backend / Server)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster

# Pusher Channels (Frontend / Client) - Must match PUSHER_KEY and PUSHER_CLUSTER
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# Cloudinary (Profile picture & chat image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (Optional - Welcome emails)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Chatify

# Google OAuth (Login with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
